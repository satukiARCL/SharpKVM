<Window x:Class="SharpKVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SharpKVM - Multi-Display Layout &amp; Controller" 
        Height="660" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="#18181B" Foreground="#F4F4F5"
        FontFamily="Segoe UI, Meiryo UI, sans-serif">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="BorderBrush" Value="#52525B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="SharpKVM" FontSize="24" FontWeight="Bold" Foreground="#60A5FA"/>
                <TextBlock x:Name="SubheaderText" Text="マルチディスプレイ環境を自動検出中..." FontSize="13" Foreground="#A1A1AA" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="StatusBadge" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="16" Padding="14,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#71717A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="停止中" FontWeight="SemiBold" FontSize="12" Foreground="#D4D4D8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Display Canvas Area -->
        <Border Grid.Row="1" Background="#111113" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
            <Grid>
                <!-- Canvas -->
                <Canvas x:Name="DisplayCanvas" Background="Transparent" 
                        MouseLeftButtonDown="DisplayCanvas_MouseDown" 
                        MouseMove="DisplayCanvas_MouseMove" 
                        MouseLeftButtonUp="DisplayCanvas_MouseUp">
                    
                    <!-- Screen Connection Direction Indicator -->
                    <Border x:Name="EdgeIndicatorBadge" Canvas.Left="20" Canvas.Top="20" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <TextBlock x:Name="EdgeIndicatorText" Text="配置方向: 右 (Right)" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>

                    <!-- Dynamic Local Monitors Canvas -->
                    <Canvas x:Name="LocalMonitorsCanvas"/>

                    <!-- Remote PC Display Box (Draggable) -->
                    <Border x:Name="RemoteMonitor" Width="160" Height="100" Canvas.Left="520" Canvas.Top="140"
                            Background="#064E3B" BorderBrush="#10B981" BorderThickness="2" CornerRadius="8"
                            Cursor="SizeAll" MouseLeftButtonDown="RemoteMonitor_MouseDown">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖥 相手 PC (Remote)" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="RemoteHostLabel" Text="127.0.0.1" FontSize="11" Foreground="#6EE7B7" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <Border Background="#047857" CornerRadius="4" Padding="6,2" Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="ドラッグして配置" FontSize="10" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Canvas>
            </Grid>
        </Border>

        <!-- Controls & Settings Area -->
        <Border Grid.Row="2" Background="#202023" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="相手 IP:" VerticalAlignment="Center" Foreground="#A1A1AA" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="RemoteHostInput" Text="127.0.0.1" Width="150" Style="{StaticResource ModernTextBox}" Margin="0,0,16,0" TextChanged="RemoteHostInput_TextChanged"/>

                    <TextBlock Text="ポート:" VerticalAlignment="Center" Foreground="#A1A1AA" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="PortInput" Text="24800" Width="80" Style="{StaticResource ModernTextBox}" Margin="0,0,16,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                    <Button x:Name="StartSenderBtn" Content="操作送信を開始" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="StartSenderBtn_Click"/>
                    <Button x:Name="StartReceiverBtn" Content="受信待機を開始" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="StartReceiverBtn_Click"/>
                    <Button x:Name="StopBtn" Content="停止" Style="{StaticResource ModernButton}" IsEnabled="False" Click="StopBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer / Hints -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="💡 マルチディスプレイ対応: " Foreground="#F59E0B" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="自PCのモニター間は自由に移動可能。一番外側の端から相手PCへ遷移します。手元に戻すキー: " Foreground="#A1A1AA" FontSize="12"/>
                <TextBlock Text="[ScrollLock] / [Pause]" Foreground="#60A5FA" FontWeight="Bold" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
